# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored and must never be committed.

# Groq API keys (get from https://console.groq.com/keys)
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_here
GROQ_API_KEY_3=your_groq_api_key_here
GROQ_API_KEY_4=your_groq_api_key_here

# SerpAPI key (get from https://serpapi.com/manage-api-key)
SERPAPI_KEY=your_serpapi_key_here
